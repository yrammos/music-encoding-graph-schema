--><?xml-model href="../validation/mei_odds.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?><?xml-model href="../validation/mei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?><specGrp xml:id="module.MEI.graphicanalysis" xmlns="http://www.tei-c.org/ns/1.0" xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron">
  <moduleSpec ident="MEI.graphicanalysis">
    <desc xml:lang="en">Graphic music component declarations.</desc>
  </moduleSpec>
  <classSpec ident="model.graphLike" module="MEI.graphicanalysis" type="model">
    <desc xml:lang="en">Groups elements that represent analytical graphs as siblings of <gi scheme="MEI">mdiv</gi> inside <gi scheme="MEI">body</gi>.</desc>
  </classSpec>
  <elementSpec ident="graph" mode="add" module="MEI.graphicanalysis">
    <gloss xml:lang="en">Analytical graph</gloss>
    <desc xml:lang="en">A hypergraph whose nodes correspond to score events, analytical relations between events, or relations between relations.</desc>
    <classes>
      <memberOf key="model.graphLike"></memberOf>
    </classes>
    <content>
      <rng:zeroOrMore>
        <rng:choice>
          <rng:ref name="node"></rng:ref>
          <rng:ref name="arc"></rng:ref>
        </rng:choice>
      </rng:zeroOrMore>
    </content>
    <constraintSpec ident="graph_undirected_not_supported" scheme="schematron">
      <constraint>
        <sch:rule context="mei:graph[@type='undirected']">
          <sch:assert role="warning" test="false()">Undirected graphs are not yet supported.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <attList>
      <attDef ident="xml:id" usage="opt">
        <desc xml:lang="en">Unique identifier for this graph.</desc>
        <datatype>
          <rng:data type="ID"></rng:data>
        </datatype>
      </attDef>
      <attDef ident="type" usage="req">
        <desc xml:lang="en">Specifies whether the graph is directed or undirected.</desc>
        <valList type="closed">
          <valItem ident="directed">
            <desc xml:lang="en">A graph in which arcs have a defined direction from source to target.</desc>
          </valItem>
          <valItem ident="undirected">
            <desc xml:lang="en">A graph in which arcs have no defined direction. Reserved for future use.</desc>
          </valItem>
        </valList>
      </attDef>
    </attList>
    <remarks xml:lang="en">
      <p>The <gi scheme="MEI">graph</gi> element appears as a sibling of <gi scheme="MEI">mdiv</gi> inside <gi scheme="MEI">body</gi>.</p>
    </remarks>
  </elementSpec>
  <elementSpec ident="node" mode="add" module="MEI.graphicanalysis">
    <gloss xml:lang="en">Graph node</gloss>
    <desc xml:lang="en">A node in the analytical graph, representing either a score event, an analytical relation between events, or a relation between relations.</desc>
    <classes></classes>
    <content>
      <rng:ref name="label"></rng:ref>
    </content>
    <constraintSpec ident="node_relation_label" scheme="schematron">
      <constraint>
        <sch:rule context="mei:node[@type='relation' or @type='metarelation']">
          <sch:assert test="mei:label/@type">A label within a relation or metarelation node must have a @type attribute.</sch:assert>
          <sch:assert test="not(mei:label/*)">A label within a relation or metarelation node must be empty.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <constraintSpec ident="node_relation_label_single_token" scheme="schematron">
      <constraint>
        <sch:rule context="mei:node[@type='relation' or @type='metarelation']">
          <sch:assert test="not(contains(normalize-space(mei:label/@type), ' '))">Within a graph, the @type attribute of a label must be a single token.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <constraintSpec ident="node_note_label" scheme="schematron">
      <constraint>
        <sch:rule context="mei:node[not(@type) or @type='note']">
          <sch:assert test="not(mei:label/@type)">A label within a note node must not have a @type attribute.</sch:assert>
          <sch:assert test="mei:label/mei:note[@corresp]">A label within a note node must contain a note element with a @corresp attribute.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <constraintSpec ident="node_note_corresp_only" scheme="schematron">
      <constraint>
        <sch:rule context="mei:node[not(@type) or @type='note']">
          <sch:assert test="mei:label/mei:note/@corresp">A note inside a label inside a graph must have a @corresp attribute.</sch:assert>
          <sch:assert test="not(mei:label/mei:note/@*[name() != 'corresp'])">A note inside a label inside a graph must have no attributes other than @corresp.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <constraintSpec ident="node_note_corresp_target" scheme="schematron">
      <constraint>
        <sch:rule context="mei:node[not(@type) or @type='note'][mei:label/mei:note/@corresp]">
          <sch:let name="id" value="substring-after(mei:label/mei:note/@corresp, '#')"></sch:let>
          <sch:assert test="//mei:score//mei:note[@xml:id = $id]">The @corresp attribute must reference a note element within a score.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <constraintSpec ident="node_in_arc" scheme="schematron">
      <constraint>
        <sch:rule context="mei:node">
          <sch:let name="graph" value="ancestor::mei:graph"></sch:let>
          <sch:let name="ref" value="concat('#', @xml:id)"></sch:let>
          <sch:assert test="$graph/mei:arc[@from = $ref or @to = $ref]">Node must appear in at least one arc within the same graph.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <attList>
      <attDef ident="xml:id" usage="req">
        <desc xml:lang="en">Unique identifier for this node.</desc>
        <datatype>
          <rng:data type="ID"></rng:data>
        </datatype>
      </attDef>
      <attDef ident="type" usage="opt">
        <desc xml:lang="en">Classifies the node. When absent, the implicit value is <val>note</val>.</desc>
        <defaultVal>note</defaultVal>
        <valList type="closed">
          <valItem ident="note">
            <desc xml:lang="en">A node representing a score event.</desc>
          </valItem>
          <valItem ident="relation">
            <desc xml:lang="en">A node representing an analytical relation between score events.</desc>
          </valItem>
          <valItem ident="metarelation">
            <desc xml:lang="en">A node representing a relation between relations.</desc>
          </valItem>
        </valList>
      </attDef>
      <attDef ident="strucl" usage="opt">
        <desc xml:lang="en">Identifies the structural layer to which this node belongs.</desc>
        <datatype>
          <rng:data type="positiveInteger"></rng:data>
        </datatype>
      </attDef>
    </attList>
  </elementSpec>
  <elementSpec ident="arc" mode="add" module="MEI.graphicanalysis">
    <gloss xml:lang="en">Graph arc</gloss>
    <desc xml:lang="en">A directed edge from a relation or metarelation node to a target node, encoding the role of the target in the relation.</desc>
    <classes></classes>
    <content>
      <rng:empty></rng:empty>
    </content>
    <constraintSpec ident="arc_targets_exist" scheme="schematron">
      <constraint>
        <sch:rule context="mei:arc">
          <sch:let name="graph" value="ancestor::mei:graph"></sch:let>
          <sch:let name="fromId" value="substring-after(@from, '#')"></sch:let>
          <sch:let name="toId" value="substring-after(@to, '#')"></sch:let>
          <sch:assert test="$graph/mei:node[@xml:id = $fromId]">@from must reference an existing node in this graph.</sch:assert>
          <sch:assert test="$graph/mei:node[@xml:id = $toId]">@to must reference an existing node in this graph.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <constraintSpec ident="arc_from_type" scheme="schematron">
      <constraint>
        <sch:rule context="mei:arc">
          <sch:let name="graph" value="ancestor::mei:graph"></sch:let>
          <sch:let name="fromId" value="substring-after(@from, '#')"></sch:let>
          <sch:assert test="$graph/mei:node[@xml:id = $fromId]/@type = ('relation', 'metarelation')">@from must reference a relation or metarelation node.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <constraintSpec ident="arc_to_type" scheme="schematron">
      <constraint>
        <sch:rule context="mei:arc">
          <sch:let name="graph" value="ancestor::mei:graph"></sch:let>
          <sch:let name="fromId" value="substring-after(@from, '#')"></sch:let>
          <sch:let name="toId" value="substring-after(@to, '#')"></sch:let>
          <sch:let name="fromType" value="$graph/mei:node[@xml:id = $fromId]/@type"></sch:let>
          <sch:assert test="if ($fromType = 'relation') then $graph/mei:node[@xml:id = $toId and (not(@type) or @type = 'note')] else true()">An arc from a relation node must target a note node.</sch:assert>
          <sch:assert test="if ($fromType = 'metarelation') then $graph/mei:node[@xml:id = $toId and @type = ('relation', 'metarelation')] else true()">An arc from a metarelation node must target a relation or metarelation node.</sch:assert>
        </sch:rule>
      </constraint>
    </constraintSpec>
    <attList>
      <attDef ident="from" usage="req">
        <desc xml:lang="en">URI reference to the source node. Must point to a relation or metarelation node within the same graph.</desc>
        <datatype>
          <rng:ref name="data.URI"></rng:ref>
        </datatype>
      </attDef>
      <attDef ident="to" usage="req">
        <desc xml:lang="en">URI reference to the target node within the same graph.</desc>
        <datatype>
          <rng:ref name="data.URI"></rng:ref>
        </datatype>
      </attDef>
      <attDef ident="type" usage="req">
        <desc xml:lang="en">Encodes the role of the target node in the relation.</desc>
        <valList type="closed">
          <valItem ident="primary">
            <desc xml:lang="en">The target node plays a primary role in the relation.</desc>
          </valItem>
          <valItem ident="secondary">
            <desc xml:lang="en">The target node plays a secondary role in the relation.</desc>
          </valItem>
        </valList>
      </attDef>
    </attList>
  </elementSpec>
</specGrp>
