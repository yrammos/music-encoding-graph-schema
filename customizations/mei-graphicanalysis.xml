  <text>
    <front>
      <divGen type="toc"></divGen>
    </front>
    <body>
      <div type="customizationDocs" xml:id="customizationDocs">
        <head>MEI Graphic Analysis</head>
        <div type="div1" xml:id="mei-graphicanalysisDocs">
          <head>MEI for Common Western Music Notation (CMN)</head>
          <p>This customization of MEI is meant to encode music notation following the principles of common western music notation (CMN) only.</p>
        </div>
      </div>
      <div type="sourceRefs" xml:id="mei-generalDocs">
        <head>General Documentation of MEI</head>
        <xi:include href="../source/docs/01-introduction.xml" xpointer="introduction"></xi:include>
        <xi:include href="../source/docs/02-shared.xml" xpointer="shared"></xi:include>
        <xi:include href="../source/docs/03-metadata.xml" xpointer="metadata"></xi:include>
        <xi:include href="../source/docs/04-cmn.xml" xpointer="cmn"></xi:include>
        <!--<xi:include href="../source/docs/05-mensural.xml" xpointer="mensural"/>-->
        <!--<xi:include href="../source/docs/06-neumes.xml" xpointer="neumes"/>-->
        <xi:include href="../source/docs/07-tablature.xml" xpointer="tablature"></xi:include>
        <xi:include href="../source/docs/08-lyricsperfdir.xml" xpointer="lyricsperfdir"></xi:include>
        <xi:include href="../source/docs/09-textencoding.xml" xpointer="textencoding"></xi:include>
        <xi:include href="../source/docs/10-analysisharm.xml" xpointer="analysisharm"></xi:include>
        <xi:include href="../source/docs/11-scholarlyediting.xml" xpointer="scholarlyediting"></xi:include>
        <xi:include href="../source/docs/12-facsimilesperformances.xml" xpointer="facsimilesperformances"></xi:include>
        <xi:include href="../source/docs/13-linkingdata.xml" xpointer="linkingdata"></xi:include>
        <xi:include href="../source/docs/14-integration.xml" xpointer="integration"></xi:include>
      </div>
    </body>
    <back>
      <div>
        <!-- Limit the set of possible start elements -->
        <schemaSpec ident="mei-graphicanalysis" ns="http://www.music-encoding.org/ns/mei" prefix="mei_" start="mei meiHead meiCorpus music">
          <!-- Declare MEI and XLink namespaces for use in Schematron -->
          <constraintSpec ident="set_ns" mode="add" scheme="schematron">
            <constraint>
              <sch:ns prefix="mei" uri="http://www.music-encoding.org/ns/mei"></sch:ns>
              <sch:ns prefix="xlink" uri="http://www.w3.org/1999/xlink"></sch:ns>
            </constraint>
          </constraintSpec>
          <!-- Include all modules -->
          <!-- Deactivate the mensural and neumes modules -->
          <moduleRef key="MEI"></moduleRef>
          <moduleRef key="MEI.analytical"></moduleRef>
          <moduleRef key="MEI.cmn"></moduleRef>
          <moduleRef key="MEI.cmnOrnaments"></moduleRef>
          <moduleRef key="MEI.corpus"></moduleRef>
          <moduleRef key="MEI.critapp"></moduleRef>
          <moduleRef key="MEI.drama"></moduleRef>
          <moduleRef key="MEI.edittrans"></moduleRef>
          <moduleRef key="MEI.externalsymbols"></moduleRef>
          <moduleRef key="MEI.facsimile"></moduleRef>
          <moduleRef key="MEI.figtable"></moduleRef>
          <moduleRef key="MEI.fingering"></moduleRef>
          <moduleRef key="MEI.frbr"></moduleRef>
          <moduleRef key="MEI.genetic"></moduleRef>
          <moduleRef key="MEI.gestural"></moduleRef>
          <moduleRef key="MEI.harmony"></moduleRef>
          <moduleRef key="MEI.header"></moduleRef>
          <moduleRef key="MEI.lyrics"></moduleRef>
          <!-- <moduleRef key="MEI.mensural"></moduleRef> -->
          <moduleRef key="MEI.midi"></moduleRef>
          <moduleRef key="MEI.msDesc"></moduleRef>
          <moduleRef key="MEI.namesdates"></moduleRef>
          <!-- <moduleRef key="MEI.neumes"></moduleRef> -->
          <moduleRef key="MEI.performance"></moduleRef>
          <moduleRef key="MEI.ptrref"></moduleRef>
          <moduleRef key="MEI.shared"></moduleRef>
          <moduleRef key="MEI.stringtab"></moduleRef>
          <moduleRef key="MEI.text"></moduleRef>
          <moduleRef key="MEI.usersymbols"></moduleRef>
          <moduleRef key="MEI.visual"></moduleRef>
          <elementSpec ident="graph" mode="add" module="MEI.shared">
            <gloss xml:lang="en">A Schenker graph.</gloss>
            <desc xml:lang="en">A graph of tonal relations.</desc>
            <classes>
              <memberOf key="att.common"></memberOf>
              <memberOf key="model.resourceLike"></memberOf>
            </classes>
            <content></content>
            <attList>
              <attDef ident="ordered" usage="opt">
                <desc xml:lang="en">Attribute description.</desc>
                <datatype>
                  <rng:ref name="data.BOOLEAN"></rng:ref>
                </datatype>
              </attDef>
            </attList>
            <remarks xml:lang="en">
              <p>HTML-formatted remarks on the element.</p>
            </remarks>
          </elementSpec>
          <!-- Include SVG -->
          <moduleRef prefix="svg_" url="../source/svg11.rng">
            <content>
              <rng:define combine="choice" name="mei_model.graphicLike">
                <rng:ref name="svg_svg"></rng:ref>
              </rng:define>
            </content>
          </moduleRef>
          <classSpec ident="att.meiVersion" mode="change" module="MEI.shared" type="atts">
            <attList>
              <attDef ident="meiversion" mode="change" usage="rec">
                <valList mode="change" type="closed">
                  <valItem ident="6.0-dev"></valItem>
                  <valItem ident="6.0-dev+cmn"></valItem>
                  <valItem ident="6.0-dev+anyStart" mode="delete"></valItem>
                  <valItem ident="6.0-dev+basic" mode="delete"></valItem>
                  <valItem ident="6.0-dev+mensural" mode="delete"></valItem>
                  <valItem ident="6.0-dev+neumes" mode="delete"></valItem>
                </valList>
              </attDef>
            </attList>
          </classSpec>
          <!-- Disable mensural- and neume-specific model classes in the shared module -->
          <!-- <classSpec ident="model.scorePart.mensuralAndNeumes" module="MEI.shared" type="model"
            mode="delete"/> -->
          <classSpec ident="model.sectionPart.mensuralAndNeumes" mode="delete" module="MEI.shared" type="model"></classSpec>
          <classSpec ident="model.staffPart.mensuralAndNeumes" mode="delete" module="MEI.shared" type="model"></classSpec>
          <classSpec ident="model.layerPart.mensuralAndNeumes" mode="delete" module="MEI.shared" type="model"></classSpec>
          <!-- Move model.noteModifierLike from layerPart.mensuralAndNeumes to editTransPart.music -->
          <classSpec ident="model.noteModifierLike" mode="replace" module="MEI.shared" type="model">
            <desc>Groups elements that modify note-like features.</desc>
            <classes>
              <memberOf key="model.editTransPart.music"></memberOf>
            </classes>
          </classSpec>
        </schemaSpec>
      </div>
    </back>
  </text>
